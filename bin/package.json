{
  "name": "gopher-migration-tooling",
  "type": "module",
  "private": true,
  "scripts": {
    "inventory": "node inventory.mjs ../Final --out out/inventory.json && cp out/inventory.summary.json ../docs/port-notes/inventory.summary.json",
    "ledger": "node changelog-ledger.mjs out/inventory.json --out-dir ../docs/port-notes",
    "extract": "node extract-services.mjs ../Final --out out/services.json --strict && cp out/services.json out/categories.json out/extract-report.md ../docs/port-notes/"
  },
  "dependencies": {
    "acorn": "^8.12.0",
    "acorn-walk": "^8.3.0",
    "fast-glob": "^3.3.0",
    "parse5": "^7.1.0"
  }
}
