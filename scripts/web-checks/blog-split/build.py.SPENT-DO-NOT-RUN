def takeaways_html(pid):
    lis = "\n".join("            <li>%s</li>" % t for t in POSTS[pid]["takeaways"])
    return ('        <aside class="takeaways">\n'
            '          <h2>Key takeaways</h2>\n'
            '          <ul>\n%s\n          </ul>\n'
            '        </aside>' % lis)


def build_post(pid):
    c, m = cards[pid], POSTS[pid]
    body = prep_body(pid)
    lead = '        <p class="post-lead">%s</p>' % c["dek"]
    marker = '<div class="reading">'
    assert marker in body, pid
    i = body.index(marker) + len(marker)
    body = body[:i] + "\n" + lead + "\n" + takeaways_html(pid) + body[i:]
    # indent the whole block two more levels so it sits inside .post-wrap
    body = "\n".join(("  " + ln) if ln.strip() else ln for ln in body.split("\n"))
    body = "    " + body.lstrip()

    rel = []
    for rid in m["related"]:
        rel.append('        <li><a href="%s"><span class="rl-cat">%s</span>%s</a></li>'
                   % (url_for(rid), cards[rid]["cat_label"], cards[rid]["title"]))

    faq = faqpage(pid)
    ld_faq = ('\n<script type="application/ld+json">\n%s\n</script>' % ld(faq)) if faq else ""

    title_plain = plain(c["title"])
    page = POST_TMPL.format(
        file=url_for(pid),
        title_tag=attr(title_plain + " – Gopher"),
        canonical=abs_url(pid),
        desc=attr(plain(m["desc"])),
        og_title=attr(title_plain + " – Gopher"),
        og_image=abs_img(c["thumb_src"]),
        published=m["published"],
        modified=m["modified"],
        section=c["cat_label"],
        ld_post=ld(blogposting(pid)),
        ld_crumb=ld(breadcrumb(pid)),
        ld_faq=ld_faq,
        catclass=catclass(c["data_cat"]),
        title=c["title"],
        date_pretty=pretty(m["published"]),
        readtime=c["readtime"],
        hero_src=c["thumb_src"],
        hero_alt=attr(html.unescape(c["thumb_alt"] or "")),
        body=body,
        related="\n".join(rel),
        footer=FOOTER_BLOCK,
    )
    open(os.path.join(FINAL, url_for(pid)), "w", encoding="utf-8").write(page)
    report["desc_len"][pid] = len(plain(m["desc"]))
    report["words"][pid] = body_wordcount(pid)


# ── index ──────────────────────────────────────────────────────────────────
def build_index():
    out = src

    # 0. the file comment described the old collapsing-<details> feed
    old_comment = """  Canonical Gopher header (self-injecting) + canonical solid-navy footer,
  dropped in verbatim. Content-first blog index: compact masthead, category
  filters, a featured story, and an editorial feed. Each story is collapsed
  by default and opens on "Read the story →" (accessible <details>). Every
  article ends with a topical CTA pathway to the relevant product page."""
    new_comment = """  Canonical Gopher header (self-injecting) + canonical solid-navy footer,
  dropped in verbatim. Content-first blog INDEX: compact masthead, category
  filters, a featured story, and an editorial feed of teaser cards.

  2026-09-16 — the 14 posts moved to one page each (blog-<slug>.html) so each
  could rank and be cited on its own. The full text of a post now lives on
  exactly one URL: its own. These cards link out; they no longer expand. The
  old #anchor ids are kept on the cards and a shim in <head> forwards them."""
    assert old_comment in out
    out = out.replace(old_comment, new_comment, 1)
    out = out.replace("  <!-- FEATURED · REALTORS -->\n", "  <!-- FEATURED -->\n", 1)

    # 1. inline <style> -> shared stylesheet
    out = re.sub(r"<style>\n.*?\n</style>",
                 '<link rel="stylesheet" href="assets/css/gopher-blog.css">',
                 out, count=1, flags=re.S)

    # 2. feed link + JSON-LD + fragment shim in <head>
    blog_ld = {
        "@context": "https://schema.org",
        "@type": "Blog",
        "name": "Gopher Blog",
        "description": "Stories, plain-English guides, and the local way to get "
                       "things done. Real problems, straight answers, and how "
                       "neighbors get them handled with Gopher.",
        "url": SITE + "gopher-blog.html",
        "inLanguage": "en-US",
        "publisher": {"@type": "Organization", "name": "Gopher", "url": SITE,
                      "logo": {"@type": "ImageObject",
                               "url": SITE + "assets/img/og-default.jpg"}},
        "blogPost": [blogposting(pid, stub=True) for pid in ORDER],
    }
    crumb_ld = {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Home", "item": SITE},
            {"@type": "ListItem", "position": 2, "name": "Gopher Blog",
             "item": SITE + "gopher-blog.html"},
        ],
    }
    shim = """<script>
/* Fragment redirect shim — the 14 posts moved to their own URLs on 2026-09-16.
   GitHub Pages cannot serve a 301, so old #anchor links, bookmarks and any
   indexed fragment are sent on in JS. The teaser cards keep their ids, so with
   JS off the link still lands on the right card. */
(function(){
  var MAP = %s;
  function go(){
    var h = (location.hash || '').replace(/^#/, '');
    if (h && Object.prototype.hasOwnProperty.call(MAP, h)) { location.replace(MAP[h]); }
  }
  go();
  window.addEventListener('hashchange', go);
})();
</script>""" % json.dumps(FRAGMAP, indent=4, sort_keys=True).replace("\n", "\n  ")

    head_add = (
        '<link rel="alternate" type="application/rss+xml" title="Gopher Blog" href="feed.xml">\n'
        '<link rel="stylesheet" href="assets/css/gopher-blog.css">\n'
        '\n<script type="application/ld+json">\n%s\n</script>\n'
        '<script type="application/ld+json">\n%s\n</script>\n'
        '%s\n' % (ld(blog_ld), ld(crumb_ld), shim)
    )
    out = out.replace('<link rel="stylesheet" href="assets/css/gopher-blog.css">',
                      head_add, 1)

    # 3. cards become teasers
    for pid in ORDER:
        c = cards[pid]
        full = None
        pat = re.compile(r'<details class="post-card[^"]*"[^>]*\sid="%s"[^>]*>.*?</details>'
                         % re.escape(pid), re.S)
        m = pat.search(out)
        assert m, pid
        full = m.group(0)
        classes = c["classes"]
        summary = c["summary"]
        teaser = summary.replace("<summary>", '<div class="pc-teaser">', 1)
        teaser = teaser.replace("</summary>", "</div>", 1)
        # title -> link
        teaser = teaser.replace(
            '<h2 class="pc-title">%s</h2>' % c["title"],
            '<a class="pc-titlelink" href="%s"><h2 class="pc-title">%s</h2></a>'
            % (url_for(pid), c["title"]), 1)
        # read-more -> link
        teaser = re.sub(
            r'<span class="pc-readmore">.*?</span>\s*</div>',
            '<a class="pc-readmore" href="%s">Read the story <span class="arrow">&rarr;</span></a>\n      </div>'
            % url_for(pid),
            teaser, count=1, flags=re.S)
        # thumbnail links too
        teaser = teaser.replace(
            '<div class="pc-thumb">', '<div class="pc-thumb">', 1)
        new = ('<article class="%s" id="%s" data-cat="%s">\n    %s\n  </article>'
               % (classes, pid, c["data_cat"], teaser.strip()))
        out = out[:m.start()] + new + out[m.end():]

    # 4. the filter JS toggled `open` on <details>; nothing is open any more
    out = out.replace("          if(!match) card.removeAttribute('open');\n", "")
    # 5. the "ease an opened story into view" block has no <details> left to watch
    ease = re.compile(r"\n  /\* ease an opened story into view \*/\n  \(function\(\)\{.*?\n  \}\)\(\);\n", re.S)
    assert ease.search(out)
    out = ease.sub("\n", out)

    open(SRC, "w", encoding="utf-8").write(out)


# ── feed.xml ───────────────────────────────────────────────────────────────
def build_feed():
    items = []
    for pid in ORDER:
        c, m = cards[pid], POSTS[pid]
        items.append(
            "    <item>\n"
            "      <title>%s</title>\n"
            "      <link>%s</link>\n"
            "      <guid isPermaLink=\"true\">%s</guid>\n"
            "      <pubDate>%s</pubDate>\n"
            "      <category>%s</category>\n"
            "      <description>%s</description>\n"
            "    </item>"
            % (esc(plain(c["title"])), abs_url(pid), abs_url(pid),
               rfc822(m["published"]), esc(plain(c["cat_label"])),
               esc(plain(c["dek"]))))
    feed = (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">\n'
        '  <channel>\n'
        '    <title>Gopher Blog</title>\n'
        '    <link>%sgopher-blog.html</link>\n'
        '    <atom:link href="%sfeed.xml" rel="self" type="application/rss+xml" />\n'
        '    <description>Stories, plain-English guides, and the local way to get things done. '
        'Real problems, straight answers, and how neighbors get them handled with Gopher.</description>\n'
        '    <language>en-us</language>\n'
        '    <lastBuildDate>%s</lastBuildDate>\n'
        '%s\n'
        '  </channel>\n'
        '</rss>\n' % (SITE, SITE, rfc822(POSTS[ORDER[0]]["modified"]), "\n".join(items)))
    open(os.path.join(FINAL, "feed.xml"), "w", encoding="utf-8").write(feed)


def esc(s):
    return (s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))


# ── sitemap ────────────────────────────────────────────────────────────────
def build_sitemap():
    p = os.path.join(FINAL, "sitemap.xml")
    sm = open(p, encoding="utf-8").read()
    assert "blog-" not in sm, "sitemap already has blog entries — rerun on a clean file"
    rows = "".join(
        "  <url><loc>%s</loc><lastmod>%s</lastmod></url>\n"
        % (abs_url(pid), POSTS[pid]["modified"])
        for pid in sorted(ORDER, key=lambda x: POSTS[x]["slug"]))
    anchor = "  <url><loc>https://gophergo.io/blinds-curtains.html</loc></url>\n"
    assert anchor in sm
    sm = sm.replace(anchor, anchor + rows, 1)
    # feed.xml is not a page; it does not belong in the sitemap.
    open(p, "w", encoding="utf-8").write(sm)


# ── inbound links elsewhere in Final/ ──────────────────────────────────────
def fix_inbound():
    changed = []
    for name in sorted(os.listdir(FINAL)):
        if not name.endswith(".html") or name == "gopher-blog.html":
            continue
        p = os.path.join(FINAL, name)
        t = open(p, encoding="utf-8").read()
        new = t
        for pid, target in FRAGMAP.items():
            new = new.replace('href="gopher-blog.html#%s"' % pid, 'href="%s"' % target)
        if new != t:
            open(p, "w", encoding="utf-8").write(new)
            changed.append(name)
    return changed


if __name__ == "__main__":
    for pid in ORDER:
        build_post(pid)
    build_index()
    build_feed()
    build_sitemap()
    ch = fix_inbound()
    print("inbound links updated in:", ch or "(none)")
    print("\nmeta description lengths (target 120-155):")
    for pid in ORDER:
        n = report["desc_len"][pid]
        print("  %-22s %3d %s" % (pid, n, "" if 120 <= n <= 155 else "  <-- OUT OF RANGE"))
    print("\nbody word counts (moved copy):")
    for pid in ORDER:
        print("  %-22s %4d" % (pid, report["words"][pid]))
