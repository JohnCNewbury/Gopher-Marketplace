#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Split Final/gopher-blog.html into 14 post pages + a teaser index.

Post copy is MOVED by text slice, never re-rendered.
"""
import datetime
import html
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from meta import POSTS, ORDER  # noqa: E402

ROOT = "/Users/johnnewbury/Desktop/All New Gopher/Documentation/Claude Code Review:Cleanup/Code"
FINAL = os.path.join(ROOT, "Final")
SRC = os.path.join(FINAL, "gopher-blog.html")
HERE = os.path.dirname(os.path.abspath(__file__))
SITE = "https://gophergo.io/"

src = open(SRC, encoding="utf-8").read()
cards = {c["id"]: c for c in json.load(open(os.path.join(HERE, "cards.json"), encoding="utf-8"))}
assert set(cards) == set(POSTS) == set(ORDER), (set(cards) ^ set(POSTS))

report = {"desc_len": {}, "words": {}}

# ── shared blocks lifted from the index ────────────────────────────────────
band_start = src.index('<!-- ═══════════════════ CLOSING BAND')
foot_end = src.index("</footer>") + len("</footer>")
FOOTER_BLOCK = src[band_start:foot_end]
# gopher-footer.css is linked from every new page's <head>; drop the mid-body copy
FOOTER_BLOCK = FOOTER_BLOCK.replace(
    '<link rel="stylesheet" href="assets/css/gopher-footer.css">\n', "")
assert "gopher-footer" in FOOTER_BLOCK and "<section class=\"band\">" in FOOTER_BLOCK

# Post pages carry no .reveal elements, so the index's entrance-animation
# script is deliberately not copied onto them.


def txt(h):
    """Visible text of an HTML fragment."""
    h = re.sub(r"(?is)<(script|style).*?</\1>", " ", h)
    h = re.sub(r"(?s)<!--.*?-->", " ", h)
    h = re.sub(r"(?s)<[^>]+>", " ", h)
    return re.sub(r"\s+", " ", html.unescape(h)).strip()


def words(h):
    return len(txt(h).split())


def plain(s):
    """Entity-bearing HTML string -> plain text for JSON-LD / feed."""
    return html.unescape(re.sub(r"(?s)<[^>]+>", "", s)).strip()


def attr(s):
    """Plain text -> safe for a double-quoted HTML attribute."""
    return (s.replace("&", "&amp;").replace('"', "&quot;")
             .replace("<", "&lt;").replace(">", "&gt;"))


def iso(d):
    return d


def rfc822(d):
    dt = datetime.datetime.strptime(d, "%Y-%m-%d").replace(hour=9)
    return dt.strftime("%a, %d %b %Y %H:%M:%S +0000")


def pretty(d):
    dt = datetime.datetime.strptime(d, "%Y-%m-%d")
    return dt.strftime("%b ") + str(dt.day) + dt.strftime(", %Y")


def catclass(data_cat):
    return {"marketplace": "cat-marketplace", "neighbors": "cat-neighbors",
            "workers": "cat-workers", "business": "cat-business",
            "merchants": "cat-merchants"}[data_cat]


def url_for(pid):
    return POSTS[pid]["slug"] + ".html"


def abs_url(pid):
    return SITE + url_for(pid)


def abs_img(src_path):
    return SITE + src_path


# fragment -> new page, used by both the shim and the in-body link rewrite
FRAGMAP = {pid: url_for(pid) for pid in ORDER}


# ── body preparation ───────────────────────────────────────────────────────
def prep_body(pid):
    c = cards[pid]
    b = c["body"]
    b = re.sub(r'\s*<div class="divider"></div>', "", b, count=1)
    b = re.sub(r'\s*<div class="pc-hero-img">.*?</div>', "", b, count=1, flags=re.S)
    # in-body cross-links to other posts' old fragments become real page links
    def sub_href(m):
        frag = m.group(1)
        if frag in FRAGMAP:
            return 'href="%s"' % FRAGMAP[frag]
        raise SystemExit("unmapped in-body fragment #%s in %s" % (frag, pid))
    b = re.sub(r'href="#([a-z0-9-]+)"', sub_href, b)
    return b.strip()


def body_wordcount(pid):
    """Words in the moved copy only — dek and takeaways excluded."""
    return words(prep_body(pid))


# ── JSON-LD ────────────────────────────────────────────────────────────────
def ld(obj):
    return json.dumps(obj, indent=2, ensure_ascii=False)


def blogposting(pid, stub=False):
    c, m = cards[pid], POSTS[pid]
    o = {
        "@type": "BlogPosting",
        "headline": plain(c["title"]),
        "url": abs_url(pid),
        "datePublished": iso(m["published"]),
        "image": abs_img(c["thumb_src"]),
    }
    if stub:
        return o
    o = {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": plain(c["title"]),
        "description": plain(m["desc"]),
        "image": abs_img(c["thumb_src"]),
        "datePublished": iso(m["published"]),
        "dateModified": iso(m["modified"]),
        "author": {"@type": "Organization", "name": "Gopher", "url": SITE},
        "publisher": {
            "@type": "Organization",
            "name": "Gopher",
            "url": SITE,
            "logo": {"@type": "ImageObject",
                     "url": SITE + "assets/img/og-default.jpg"},
        },
        "mainEntityOfPage": {"@type": "WebPage", "@id": abs_url(pid)},
        "url": abs_url(pid),
        "articleSection": plain(c["cat_label"]),
        "wordCount": body_wordcount(pid),
        "inLanguage": "en-US",
    }
    return o


def breadcrumb(pid):
    c = cards[pid]
    return {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {"@type": "ListItem", "position": 1, "name": "Home", "item": SITE},
            {"@type": "ListItem", "position": 2, "name": "Gopher Blog",
             "item": SITE + "gopher-blog.html"},
            {"@type": "ListItem", "position": 3, "name": plain(c["title"]),
             "item": abs_url(pid)},
        ],
    }


def faqpage(pid):
    qs = POSTS[pid]["faq"]
    if not qs:
        return None
    return {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {"@type": "Question", "name": q,
             "acceptedAnswer": {"@type": "Answer", "text": a}}
            for q, a in qs
        ],
    }


