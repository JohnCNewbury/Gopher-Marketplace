# Netlify redirect rules for the Gopher prototype (Final/ deployed as site root).
# This file is Netlify-specific and is ignored by the GitHub Pages / TigerTech deploys.
#
# Serve the Gopher Deals pre-registration page at the bare domain so the link
# you send merchants can be just https://<your-site>.netlify.app/
# (200 = rewrite: the URL stays "/", the deals page is served in place.)
/            /gopher-deals.html   200

# Friendly short paths that also land on the pre-registration page.
/deals       /gopher-deals.html   200
/register    /gopher-deals.html   200
