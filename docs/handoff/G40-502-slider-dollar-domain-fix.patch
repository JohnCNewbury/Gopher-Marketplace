 });
+
+/* ══════════════════════════════════════════════════════════════════════════
+   G40-502 — THE RAIL'S DOMAIN IS DOLLARS, NOT PERCENT.
+
+   The defect these guard: the slider ran `min=0 max=100` while the value was
+   held in whole dollars, so each drag round-tripped percent -> dollars ->
+   percent through two roundings. On a narrow track most drags rounded back to
+   a DIFFERENT percent, React re-rendered the thumb away from the finger, and
+   only a jump large enough to cross a dollar boundary held. The owner hit it on
+   an iPhone 15 Pro Max: "I have to tap to a spot on the slider to move it."
+
+   ⛔ WHY A SWEEP AND NOT A SAMPLE. A test pinned to one or two values passes
+   happily with the quantisation merely moved somewhere else on the track —
+   which is exactly how this shipped in the first place. Same reasoning as the
+   monotonicity sweep on the cost curve: assert the property across the whole
+   domain, not at points that happen to be clean.
+
+   ⚠️ The failure is tactile, and jsdom cannot feel a thumb fighting a finger.
+   These tests pin the CAUSE (a lossy value domain); the effect still needs a
+   handset. Do not read a green run here as "the drag is smooth".
+   ══════════════════════════════════════════════════════════════════════════ */
+describe("G40-502 — the suggested-offer rail is driven in dollars", () => {
+  /* ⚠️ This block is a SIBLING of the main describe, so it does not inherit its
+     beforeEach. Without fake timers the 350ms debounced fetch never fires, the
+     band never arrives, and the entry row never renders — the first draft of
+     these tests failed on `entryRow()` being undefined, which looks like a
+     product bug and is not one. Mirror the setup rather than nesting, so these
+     stay readable as a group. */
+  beforeEach(() => {
+    jest.clearAllMocks();
+    jest.useFakeTimers();
+  });
+  afterEach(async () => {
+    if (root) await unmount();
+    jest.useRealTimers();
+  });
+
+  const rail = () => document.querySelector('input[type="range"]');
+
+  /* React 18 tracks the input's value internally, so assigning `.value` is
+     ignored. Go through the prototype's native setter, then fire `input` —
+     the same trick the rest of this file uses for text entry. */
+  async function dragTo(el, value) {
+    const setter = Object.getOwnPropertyDescriptor(
+      window.HTMLInputElement.prototype,
+      "value",
+    ).set;
+    // eslint-disable-next-line testing-library/no-unnecessary-act
+    await act(async () => {
+      setter.call(el, String(value));
+      el.dispatchEvent(new Event("input", { bubbles: true }));
+    });
+  }
+
+  it("min/max are the dollar track bounds, never 0..100", async () => {
+    API.post.mockResolvedValue(priced(14, 11, 18));
+    await mount({ cost_of_goods: 50 });
+    await click(entryRow());
+
+    const r = rail();
+    expect(r).toBeTruthy();
+    /* TRACK_SPREAD 1.6, band 11/14/18 -> half = max(3,4,1)*1.6 = 6.4
+       -> trackMin round(7.6)=8, trackMax round(20.4)=20. */
+    expect(r.getAttribute("min")).toBe("8");
+    expect(r.getAttribute("max")).toBe("20");
+    expect(r.getAttribute("step")).toBe("1");
+  });
+
+  it("EVERY integer position round-trips to itself", async () => {
+    API.post.mockResolvedValue(priced(14, 11, 18));
+    await mount({ cost_of_goods: 50 });
+    await click(entryRow());
+
+    const r = rail();
+    const min = Number(r.getAttribute("min"));
+    const max = Number(r.getAttribute("max"));
+    expect(max).toBeGreaterThan(min);
+
+    const drifted = [];
+    for (let v = min; v <= max; v += 1) {
+      await dragTo(rail(), v);
+      const landed = Number(rail().value);
+      if (landed !== v) drifted.push({ asked: v, landed });
+    }
+    expect(drifted).toEqual([]);
+  });
+
+  it("holds on the narrowest track on the platform — the $10 floor", async () => {
+    /* Severity was inverse to track width, so the floor is the worst case:
+       band 8/10/13 -> half = max(2,3,1)*1.6 = 4.8 -> $5..$15. */
+    API.post.mockResolvedValue(priced(10, 8, 13));
+    await mount({ cost_of_goods: 0 });
+    await click(entryRow());
+
+    const r = rail();
+    const min = Number(r.getAttribute("min"));
+    const max = Number(r.getAttribute("max"));
+
+    const drifted = [];
+    for (let v = min; v <= max; v += 1) {
+      await dragTo(rail(), v);
+      if (Number(rail().value) !== v) drifted.push(v);
+    }
+    expect(drifted).toEqual([]);
+  });
+});
