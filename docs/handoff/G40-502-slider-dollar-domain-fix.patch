diff --git a/src/component/smartPriceSuggestion.test.js b/src/component/smartPriceSuggestion.test.js
index b5c2adb4a..d5147511f 100644
--- a/src/component/smartPriceSuggestion.test.js
+++ b/src/component/smartPriceSuggestion.test.js
@@ -889,3 +889,109 @@ describe("SmartPriceSuggestion — bids path (G40-534 AC8)", () => {
