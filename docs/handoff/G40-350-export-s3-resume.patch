+/* ⛔ RESUME FROM S3 AS WELL AS THE MANIFEST.
+
+   The manifest is the only resume state this script originally had, and it is a
+   LOCAL FILE. It runs where the backend runs, so the manifest lives on that box
+   and is routinely not the box you re-run from. Without it every scan ref is
+   refetched: on 2026-08-31 that was ~6,973 holders x ~3 images ~= 21,000 fetches
+   to recover 242 missing ones.
+
+   Free -- iDenfy bills approved verifications, not file reads -- but slow enough
+   that the re-run gets deferred, and this is the one step that becomes
+   IMPOSSIBLE when the vendor account lapses. A resume mechanism that is
+   expensive to use is one that does not get used in time.
+
+   So: ask S3 what we already hold. That is authoritative, survives losing the
+   manifest, and is the same store the app serves from.
+
+   ⚠️ "Already mirrored" means FRONT *and* FACE. Those are the two the worker's
+   at-door screen renders (licence + selfie); BACK is a bonus iDenfy may or may
+   not hold. Skipping on "any object present" would strand a holder who has only
+   FRONT -- exactly the half-mirrored case this is meant to close.
+
+   Uses mirrored_keys() from helpers/trustshield_files.js rather than rebuilding
+   the key layout, so the script and the serving path can never disagree about
+   where an image lives. */
+const REQUIRED_TYPES = ['FRONT', 'FACE'];
+
+const s3_already_complete = async (scan_ref) => {
+  if (NO_S3_RESUME) return false;
+  try {
+    const keys = await mirrored_keys(scan_ref);
+    return REQUIRED_TYPES.every((t) => keys[t]);
+  } catch (error) {
+    /* A listing failure must never be read as "already done" -- that would
+       silently skip a holder we do not hold. Fall through and fetch. */
+    console.log(
+      `  ! S3 check failed for ${scan_ref} (${error.message}) — fetching anyway`
+    );
+    return false;
+  }
+};
+
